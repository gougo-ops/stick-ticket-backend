# ═══════════════════════════════════════════════════════════
#  本地开发：使用 SQLite（开箱即用，无需额外配置）
# ═══════════════════════════════════════════════════════════
DATABASE_URL=sqlite:///./stick_ticket.db

# ═══════════════════════════════════════════════════════════
#  Railway / Render 部署：请勿在此设置 DATABASE_URL
#  请在 Railway/Render Dashboard 添加 PostgreSQL 数据库
#  平台会自动注入 DATABASE_URL 环境变量覆盖此默认值
#
#  手动设置 PostgreSQL 示例（替换为实际值）：
#  DATABASE_URL=postgresql://user:password@host:5432/dbname
#  DATABASE_URL=postgresql://postgres.xxx:5432/postgres?pgbouncer=true  (Supabase)
# ═══════════════════════════════════════════════════════════

JWT_SECRET=stick-ticket-jwt-prod-2026-secure
JWT_EXPIRE_HOURS=24
